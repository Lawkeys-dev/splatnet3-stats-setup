[Unit]
Description=s3s stat.ink uploader (monitoring mode, auto token refresh)
Documentation=https://github.com/frozenpandaman/s3s
After=network-online.target
Wants=network-online.target
# the hourly token timer boots its own emulator; splatnet3-token-util cannot cope
# with two emulators at once, so the two must never run together
Conflicts=splatnet3-tokens.service
# don't let a hard failure loop hot
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# without a terminal Python buffers its output, so the journal would only see it in 8 KB
# blocks; s3s and stu run as child processes and inherit this
Environment=PYTHONUNBUFFERED=1
# the emulator is the only adb target the token util means; a phone visible over
# wireless adb makes every untargeted `adb shell` fail with "more than one device"
Environment=ANDROID_SERIAL=emulator-5554
# same cause, other symptom: with the phone listed, `adb devices` is never empty, so the
# shutdown step never sees the emulator go away. Must be set where the adb server starts.
Environment=ADB_MDNS_AUTO_CONNECT=0
Type=simple
# -r  upload anything stat.ink is missing, then
# -M  poll SplatNet 3 every 300s and upload new battles/jobs as they finish
ExecStart=%h/Work/splatnet3/bin/stu-s3s -r -M
# s3s calls input() at startup if a newer version exists upstream. With no stdin that
# raises EOFError instead of hanging forever; the restart then git-pulls (s3s_update)
# and the service heals itself.
StandardInput=null
Restart=always
RestartSec=60s
ExecStopPost=-/bin/sh -c 'ADB=%h/Android/Sdk/platform-tools/adb; $ADB devices | grep -q emulator- && $ADB emu kill || true'
Nice=5

[Install]
WantedBy=default.target
