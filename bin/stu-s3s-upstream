#!/usr/bin/env bash
# splatnet3-token-util's own run_s3s.py loop: every token expiry boots the emulator.
# Kept as a fallback; the normal entry point is stu-s3s.
set -euo pipefail
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"
# resolve the checkout from this script's own location (works through the ~/.local/bin symlink)
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$ROOT/splatnet3-token-util"
exec "$ROOT/.venv/bin/python" run_s3s.py "$@"
